# Copy to .env next to your script and load it with load_dotenv(path, override=True).
# Keep this file out of source control.

# API key from https://dashboard.eyepop.ai under API Keys. Read by the CLI and both SDKs.
EYEPOP_API_KEY=eyp_...

# Account UUID, needed by the Python data endpoint (datasets, ground truth, ability registration).
# eyepop get accounts prints it after eyepop auth login.
EYEPOP_ACCOUNT_ID=

# Optional: attach every SDK session to a persistent deployment instead of creating a transient one.
# EYEPOP_SESSION_UUID=

# Optional: talk to an on-premise instance at http://127.0.0.1:8080 instead of the cloud.
# EYEPOP_LOCAL_MODE=true
